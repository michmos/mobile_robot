<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- robot properties -->
  <xacro:property name="chassis_length" value="0.15"/>
  <xacro:property name="chassis_width" value="0.1"/>
  <xacro:property name="chassis_height" value="0.05"/>
  <xacro:property name="chassis_mass" value="0.5"/>


  <xacro:property name="wheel_radius" value="0.0325"/>
  <xacro:property name="wheel_length" value="0.02"/>
  <xacro:property name="wheel_mass" value="0.1"/>

  <xacro:property name="caster_wheel_radius" value="${wheel_radius/2}"/>
  <xacro:property name="caster_wheel_mass" value="0.1"/>


</robot>
