<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- robot properties -->
  <xacro:property name="chassis_length" value="0.20"/>
  <xacro:property name="chassis_width" value="0.15"/>
  <xacro:property name="chassis_height" value="0.09"/>
  <xacro:property name="chassis_mass" value="0.5"/>


  <xacro:property name="wheel_radius" value="0.0335"/>
  <xacro:property name="wheel_length" value="0.027"/>
  <xacro:property name="wheel_mass" value="0.1"/>
  <xacro:property name="wheel_gap" value="0.007"/>

  <xacro:property name="caster_wheel_radius" value="${wheel_radius/2}"/>
  <xacro:property name="caster_wheel_mass" value="0.1"/>

  <xacro:property name="imu_length" value="0.02"/>
  <xacro:property name="imu_width" value="0.02"/>
  <xacro:property name="imu_height" value="0.01"/>
  <xacro:property name="imu_mass" value="0.01"/>

  <xacro:property name="lidar_radius" value="0.04"/>
  <xacro:property name="lidar_height" value="0.04"/>
  <xacro:property name="lidar_mass" value="0.15"/>

</robot>
